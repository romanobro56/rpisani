# Copy to .env.local for development, and set the same names in Vercel for production.

# --- Admin -----------------------------------------------------------------------------------
# Generate with: npm run hash-password -- 'a long password'
ADMIN_PASSWORD_HASH=
# Plain-text alternative, fine for local development only.
# ADMIN_PASSWORD=
# Signs the admin session cookie and salts visitor hashes. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Database --------------------------------------------------------------------------------
# Any Postgres. Neon's free tier via the Vercel Marketplace sets this automatically.
# Leave unset locally to use the embedded database in .data/pglite.
DATABASE_URL=

# --- Media storage (Cloudflare R2) -----------------------------------------------------------
# Leave unset locally to store uploads in .data/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket, e.g. https://media.rpisani.dev (custom domain) or https://pub-xxxx.r2.dev
MEDIA_PUBLIC_URL=
