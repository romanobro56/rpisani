{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run db:migrate && next build",
  "outputDirectory": ".next",
  "functions": {
    "api/bike-weather*.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,node_modules/**,.next/**,content/**,.git/**,automation/test_*.py}"
    }
  },
  "crons": [
    {
      "path": "/api/bike-weather",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/bike-weather",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/bike-weather-backup",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/bike-weather-backup",
      "schedule": "0 17 * * *"
    }
  ]
}
